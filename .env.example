# ============================================================
# LAPI - Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# --- Application ---
LAPI_ENV=development                    # "production" active les controles stricts
LAPI_SECRET_KEY=                        # OBLIGATOIRE en production (min 32 chars)

# --- Base de donnees ---
LAPI_DATABASE_URL=sqlite:///./lapi.db   # PostgreSQL en prod: postgresql://user:pass@host/db

# --- Admin (premier lancement) ---
LAPI_ADMIN_USERNAME=admin
LAPI_ADMIN_PASSWORD=                    # Min 12 chars, 1 maj, 1 chiffre, 1 special en prod

# --- MQTT (communication edge) ---
LAPI_MQTT_BROKER=localhost
LAPI_MQTT_PORT=8883
LAPI_MQTT_USERNAME=
LAPI_MQTT_PASSWORD=
LAPI_MQTT_USE_TLS=true
LAPI_MQTT_CA_CERT=                      # Chemin vers CA cert (optionnel)
LAPI_MQTT_CLIENT_CERT=                  # Chemin vers client cert (optionnel)
LAPI_MQTT_CLIENT_KEY=                   # Chemin vers client key (optionnel)

# --- Stripe (paiements) ---
STRIPE_SECRET_KEY=                      # Vide = mode dev (activation directe sans paiement)
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                  # OBLIGATOIRE en prod si Stripe actif

# --- SMTP (emails) ---
LAPI_SMTP_HOST=                         # Vide = emails logges mais non envoyes
LAPI_SMTP_PORT=587
LAPI_SMTP_USERNAME=
LAPI_SMTP_PASSWORD=
LAPI_SMTP_FROM=noreply@lapi.fr
LAPI_SMTP_USE_TLS=true

# --- Web ---
LAPI_WEB_BASE_URL=http://localhost:8000
LAPI_OTA_DIR=app/static/ota
LAPI_LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR

# --- Monitoring ---
SENTRY_DSN=                             # DSN Sentry (vide = désactivé)

# --- Docker (utilisé par docker-compose) ---
POSTGRES_PASSWORD=                      # Mot de passe PostgreSQL
MQTT_USERNAME=lapi-web
MQTT_PASSWORD=
